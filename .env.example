# Copy this file to `.env` (gitignored) and fill in real values.
# Never commit real tokens or paths to git, even in a private repo.
#
# All keys below are picked up by `_load_dotenv()` at module load time
# (in src/slack_bridge/main.py and src/multi_agent_caption/main.py).
# Existing process env vars take precedence over .env, so you can also
# override anything here on the command line: `KEY=value python ...`.

# ── Slack bridge ────────────────────────────────────────────────────────

# Bot User OAuth Token. Required.
# Slack app -> OAuth & Permissions -> "Bot User OAuth Token". Starts xoxb-.
SLACK_BOT_TOKEN=xoxb-replace-me

# App-Level Token. Required.
# Slack app -> Basic Information -> App-Level Tokens -> Generate Token
# and Scopes (must include `connections:write`). Starts xapp-.
SLACK_APP_TOKEN=xapp-replace-me

# User OAuth Token. OPTIONAL — only needed for tests/slack_drive.py
# (the end-to-end Slack driver). Slack app -> OAuth & Permissions ->
# "User OAuth Token" after adding the user-token scopes. Starts xoxp-.
# Required user-token scopes:
#   chat:write, channels:history, groups:history, im:history,
#   channels:read, groups:read, im:read, files:read, files:write,
#   groups:write
# SLACK_USER_TOKEN=xoxp-replace-me

# Password applied to encrypted zips uploaded via `!upload --link` /
# pixeldrain (option 2 of the menu). The default in source is "changeme"
# — set this to anything you want; the bridge surfaces the value in the
# `!upload` menu and the Slack post that includes the download link.
# Once you publish anything via this path, anyone with URL + password
# can extract.
LINK_UPLOAD_PASSWORD=changeme
