# Copy this to .env and fill in real values. .env is gitignored.
# Never commit real tokens to git, even in a private repo.

# Bot User OAuth Token. Starts with xoxb-.
# Slack app -> OAuth & Permissions -> "Bot User OAuth Token"
SLACK_BOT_TOKEN=xoxb-replace-me

# App-Level Token with connections:write scope. Starts with xapp-.
# Slack app -> Basic Information -> App-Level Tokens -> Generate Token and Scopes
SLACK_APP_TOKEN=xapp-replace-me
